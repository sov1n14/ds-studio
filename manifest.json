        "content/temporary-chat-history-hook.js",
        "content/prevent-auto-scroll.js",
        "content/temporary-chat-fiber-delete.js"
      ],
      "matches": [
        "*://chat.deepseek.com/*"
      ]
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

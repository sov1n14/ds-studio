{
  "name": "ds-studio-test",
  "private": true,
  "type": "module",
  "description": "Test harness for DS studio Chrome extension.",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test -c playwright.config.js",
    "test:mutation": "cd .. && npx --prefix test stryker run test/stryker.config.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^16.0.0",
    "jsdom": "^31.0.0",
    "vitest": "^3.2.4"
  }
}

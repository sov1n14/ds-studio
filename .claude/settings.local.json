{
  "permissions": {
    "allow": [
      "PowerShell",
      "Bash"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-teammate.sh\"",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
